* text=auto
*.sh text eol=lf

# The Rust artifact source snapshot hashes raw bytes across clean checkouts.
engine/** text=auto eol=lf
scripts/build-rust-engine.mjs text eol=lf
scripts/rust-engine-common.mjs text eol=lf
tests/fixtures/rust-engine/r3/historical-saves/*.json text eol=lf
app/game/rust-integrated-runtime-domain-schema.generated.ts text eol=lf
tests/fixtures/rust-engine/locator/*.json text eol=lf

# Content-addressed publication checksums cover exact generated bytes. Neither
# checkout nor archive may normalize its JavaScript, declarations, or manifests.
public/engine/** -text

*.mp3 binary
*.wav binary
*.png binary
*.jpg binary
*.jpeg binary
